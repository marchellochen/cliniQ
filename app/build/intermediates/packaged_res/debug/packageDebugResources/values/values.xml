<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#F7FCFC</color>
    <color name="gray">#757575</color>
    <color name="mint">#E3F5F6</color>
    <color name="scrub_blue">#2F6DB5</color>
    <color name="teal">#0E9AA7</color>
    <color name="teal_dark">#0B6E79</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">CliniQ</string>
    <style name="BigButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="BigButtonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="Field" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="InfoCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/mint</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Theme.ClinicQueue" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorPrimaryVariant">@color/teal_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/scrub_blue</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
</resources>