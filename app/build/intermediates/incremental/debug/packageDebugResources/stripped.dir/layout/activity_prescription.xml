<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="Did the doctor prescribe you any medicine?"
        android:textColor="@color/teal_dark" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/gray"
        android:text="If yes, we'll give you a queue number for the pharmacy." />
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <Button android:id="@+id/btnYes" style="@style/BigButton" android:text="Yes, I have a prescription" />
    <Button android:id="@+id/btnNo" style="@style/BigButtonOutlined" android:text="No medicine" />
</LinearLayout>
