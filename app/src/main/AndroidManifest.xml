<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/cliniq_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/cliniq_launcher_round"
        android:theme="@style/Theme.CliniQ">
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SignupActivity" />
        <activity android:name=".HomeActivity" />
        <activity android:name=".DoctorsActivity" />
        <activity android:name=".FormActivity" />
        <activity android:name=".PrescriptionActivity" />
        <activity android:name=".EditProfileActivity" />
        <activity
            android:name=".SpecialtiesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AppointmentFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>